# Telegram bot token, from @BotFather
BOT_TOKEN=put_your_token_here

# Your chat ID: message the bot and read getUpdates, or use @userinfobot
CHAT_ID=123456789

# Address of the agent on the gaming PC. Use the Tailscale IP, NOT the hostname:
# the bot runs inside Docker and the container can't resolve MagicDNS hostnames
# like "my-pc", even though the host can. An IP always works. Find it on the PC
# with:  tailscale ip -4
AGENT_URL=http://100.x.x.x:8770

# MAC of the gaming PC, for Wake-on-LAN
PC_MAC=AA:BB:CC:DD:EE:FF

# LAN broadcast address, usually the last address of the subnet
BROADCAST=192.168.1.255

